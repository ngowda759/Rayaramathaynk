{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Rayaramathaynk/.ai/schemas/loop-state.schema.json",
  "title": "Rayaramathaynk AI development loop state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loopId",
    "status",
    "round",
    "maxReviewRounds",
    "currentTaskId",
    "currentPr",
    "lastVerdict",
    "lastCiStatus",
    "reviewedHeadSha",
    "blockedReason",
    "updatedAt",
    "history"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "loopId": {
      "type": "string",
      "pattern": "^AI-[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "architecting",
        "implementing",
        "ci-running",
        "reviewing",
        "fixing",
        "ready-to-merge",
        "merging",
        "completed",
        "next-task",
        "human-review-required",
        "blocked"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "maxReviewRounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "currentTaskId": {
      "type": ["string", "null"]
    },
    "currentPr": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number", "branch", "headSha"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "lastVerdict": {
      "type": ["string", "null"],
      "enum": ["approved", "changes-requested", "blocked", null]
    },
    "lastCiStatus": {
      "type": ["string", "null"],
      "enum": ["success", "failure", "pending", "unknown", null]
    },
    "reviewedHeadSha": {
      "type": ["string", "null"],
      "minLength": 7
    },
    "blockedReason": {
      "type": ["string", "null"]
    },
    "completedTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AI-[0-9]+(-T[0-9]+)?$"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "status", "note"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
