{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Rayaramathaynk/.ai/schemas/task-brief.schema.json",
  "title": "Rayaramathaynk AI development loop task brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "phase",
    "status",
    "summary",
    "acceptanceCriteria",
    "outOfScope",
    "humanApproval",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AI-[0-9]+(-T[0-9]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "queued",
        "in-progress",
        "in-review",
        "ready-to-merge",
        "blocked",
        "done"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "humanApproval": {
      "type": "boolean"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AI-[0-9]+(-T[0-9]+)?$"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "pr": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "branch": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "headSha": {
      "type": ["string", "null"],
      "minLength": 7
    },
    "mergedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reviewFindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
