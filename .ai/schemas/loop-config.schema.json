{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Rayaramathaynk/.ai/schemas/loop-config.schema.json",
  "title": "Rayaramathaynk AI development loop configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loopId",
    "maxReviewRounds",
    "baseBranch",
    "branchPrefix",
    "ciWorkflow",
    "ciWorkflowFile",
    "requiredChecks",
    "protectedPaths",
    "mergeGate",
    "review",
    "automation",
    "limits",
    "paths"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "loopId": {
      "type": "string",
      "pattern": "^AI-[0-9]+$"
    },
    "maxReviewRounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "baseBranch": {
      "type": "string",
      "minLength": 1
    },
    "branchPrefix": {
      "type": "string",
      "minLength": 1
    },
    "ciWorkflow": {
      "type": "string",
      "minLength": 1
    },
    "ciWorkflowFile": {
      "type": "string",
      "minLength": 1
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mergeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requireCiGreen", "requireReviewPassed", "requireHumanApproval"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requireCiGreen": {
          "type": "boolean"
        },
        "requireReviewPassed": {
          "type": "boolean"
        },
        "requireHumanApproval": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "endpoint", "model", "schema", "markerName"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiKeyEnvVar": {
          "type": "string",
          "minLength": 1
        },
        "modelEnvVar": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "markerName": {
          "type": "string",
          "minLength": 1
        },
        "commentOnEveryRound": {
          "type": "boolean"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "autoAdvanceTasks",
        "autoMerge",
        "maxConcurrentTasks",
        "nextTaskEnabled",
        "stopOnHumanReviewRequired",
        "stopOnProtectedPath",
        "triggerLabel",
        "reviewLabel",
        "blockedLabel",
        "readyLabel"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "autoAdvanceTasks": {
          "type": "boolean"
        },
        "autoMerge": {
          "type": "boolean"
        },
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "nextTaskEnabled": {
          "type": "boolean"
        },
        "stopOnHumanReviewRequired": {
          "type": "boolean"
        },
        "stopOnProtectedPath": {
          "type": "boolean"
        },
        "triggerLabel": {
          "type": "string",
          "minLength": 1
        },
        "reviewLabel": {
          "type": "string",
          "minLength": 1
        },
        "blockedLabel": {
          "type": "string",
          "minLength": 1
        },
        "readyLabel": {
          "type": "string",
          "minLength": 1
        },
        "nextTaskBranchPrefix": {
          "type": "string",
          "minLength": 1
        },
        "mergeMethod": {
          "type": "string",
          "enum": ["merge", "squash", "rebase"]
        },
        "useNativeAutoMerge": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxChangedFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxDiffLines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "queue", "reviewLog", "taskDocs"],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "reviewLog": {
          "type": "string",
          "minLength": 1
        },
        "taskDocs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
