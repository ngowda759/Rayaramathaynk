rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user document exists and has admin role
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'temple_admin', 'admin', 'Billing'];
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isPriestOrAbove() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'temple_admin', 'priest'];
    }
    
    // True when a users write changes an access field. `role`, `isActive` and
    // `isApproved` are written only by the server staff API (Admin SDK, which
    // bypasses these rules), so no client - not even a super admin - may change
    // them. Adding a missing one counts as a change; repeating an unchanged
    // value does not. The site's sign-in merge (lib/auth/sign-in-profile.ts)
    // sends these fields only when it creates the profile, so a staff doc the
    // staff API wrote without `isApproved` still signs in.
    function changesUserAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'isApproved', 'isActive']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow read: if isAdmin();
      // Sign-up: only your own doc, only as a devotee, never pre-approved or inactive.
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'devotee')
        && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false)
        && (!('isActive' in request.resource.data) || request.resource.data.isActive == true);
      allow update: if (isOwner(userId) || isAdmin()) && !changesUserAccessFields();
      allow delete: if isSuperAdmin();
    }
    
    // Public collections
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Gallery collections
    match /galleryAlbums/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /galleryMedia/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /timings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // The public mirror of the seva catalogue. The seva settings write it through
    // the Admin SDK (which bypasses these rules) after every audited save, so from
    // a browser only a super admin may write it: the rules cannot see a temple
    // admin's view-only switch (A3 security gate L-6, plan C-39).
    match /sevas/{sevaId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Receipt Book collections
    // Seva catalogue used only by the Admin Receipt Book. Writes are validated
    // server-side via /api/admin/receipt-sevas; routes allow only admins and reject
    // negative prices/empty names. Sevas can never be physically deleted (only disabled).
    match /receiptSevas/{sevaId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0;
      allow update: if isAdmin() &&
        (!("name" in request.resource.data) || request.resource.data.name.size() > 0) &&
        (!("amount" in request.resource.data) || request.resource.data.amount >= 0);
      allow delete: if false;
    }

    // Receipt documents are only written by the server-side API (which bypasses
    // these rules, using the service account) so that receipt numbers are always
    // allocated server-side in a transaction. Public users can never create,
    // modify, or delete receipts.
    match /receipts/{receiptId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Internal counters used for atomic receipt numbering. Server-only writes.
    match /system/{docId} {
      allow read: if false;
      allow write: if false;
    }
    
    match /sevaBookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /donations/{donationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /aaradhane/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /aaradhanes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings collection (public read for About Us, Trust Committee, etc.)
    // settings/financeSettings holds the UPI id the seva counter shows on its
    // payment QR, so only a super admin may write it: the rules cannot see a
    // temple admin's view-only switch, and legacy admin roles get no seva rights
    // (A3 security gate H-1). The server also audits any change it reads.
    match /settings/{docId} {
      allow read: if true;
      allow write: if (docId != 'financeSettings' && isAdmin())
        || (docId == 'financeSettings' && isSuperAdmin());
    }

    // Bills collection
    match /bills/{billId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Homepage collection
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Future Plans collection
    match /futurePlans/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Trust Committee collection
    match /trustCommittee/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Testimonials collection
    match /testimonials/{docId} {
      allow read: if true;
      allow create: if true; // Public can submit testimonials
      allow update, delete: if isAdmin();
    }

    // Members collection (public read for analytics)
    match /members/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Volunteers collection (public read for analytics)
    match /volunteers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat sessions for AI analytics (public read)
    match /chat_sessions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // Page views collection for analytics (public read, system write)
    match /page_views/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // AI Analytics collections (public read for dashboard)
    match /ai_token_usage/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /ai_latency_records/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /ai_intent_distribution/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /unknown_questions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ai_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // `settings` is matched once only, above (public read, admin-only write).
    // Firestore ORs every matching rule, so a second open match here would let
    // anyone rewrite settings/financeSettings and its UPI id.

    // Chat messages collection (public read for conversation history)
    match /messages/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Feedback collection (public create for user feedback)
    match /feedback/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Temple Areas collection (Temple Explorer)
    match /temple_areas/{areaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Knowledge Centre collections
    match /knowledge/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /knowledge_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /knowledge_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Quotes collection for daily inspiration
    match /quotes/{quoteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
