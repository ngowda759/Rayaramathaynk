# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > Your apps > SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Optional: Firebase Analytics (can be left empty)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# VERCEL BLOB STORAGE (for testimonial photos)
# =============================================================================
# Get these from: Vercel Dashboard > Storage > Your Blob Store > Settings
BLOB_STORE_ID=your-blob-store-id
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# =============================================================================
# RAYA AI ASSISTANT CONFIGURATION
# =============================================================================
# AI Provider: openai, gemini, claude, openrouter
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration (alternative)
# GOOGLE_GENERATIVE_API_KEY=your-gemini-api-key

# Claude Configuration (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter Configuration (alternative)
# OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# SECURITY SETTINGS (Optional)
# =============================================================================

# Rate limiting - requests per minute per IP (default: 100)
# RATE_LIMIT_REQUESTS=100

# Enable/disable features based on environment
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: address diagnosed by `npm run diagnose:raya-admin-login` (read-only).
RAYA_ADMIN_EMAIL=
# Raya AI password recovery also needs the reset address on the project's
# redirect allow-list: Authentication > URL Configuration > Redirect URLs.
# See docs/RAYA_AI_PASSWORD_RECOVERY.md. This is a dashboard setting, not a
# variable here.

# Prisma migrations only. Use a DIRECT (non-pooled) PostgreSQL connection here:
# `prisma migrate` needs a session that can hold DDL locks, which a
# transaction-pooled URL cannot provide. Leave unset unless you are running
# migrations. The application runtime does not read this variable.
# PRISMA_DATABASE_URL=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres
