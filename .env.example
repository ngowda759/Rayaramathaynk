# Supabase is the only backend (authentication, database, profiles, storage,
# settings and analytics). There is no Firebase: no Firestore, no Firebase Auth,
# no Firebase Storage. See the SUPABASE CONFIGURATION block at the end of this file.

# =============================================================================
# VERCEL BLOB STORAGE (for testimonial photos)
# =============================================================================
# Get these from: Vercel Dashboard > Storage > Your Blob Store > Settings
BLOB_STORE_ID=your-blob-store-id
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# =============================================================================
# RAYA AI ASSISTANT CONFIGURATION
# =============================================================================
# AI Provider: openai, gemini, claude, openrouter
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration (alternative)
# GOOGLE_GENERATIVE_API_KEY=your-gemini-api-key

# Claude Configuration (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter Configuration (alternative)
# OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# SECURITY SETTINGS (Optional)
# =============================================================================

# Rate limiting - requests per minute per IP (default: 100)
# RATE_LIMIT_REQUESTS=100

# Enable/disable features based on environment
NEXT_PUBLIC_ENVIRONMENT=development

# Google sign-in (docs/auth/GOOGLE-SIGNIN.md). Default OFF: the "Continue with Google" button is
# not rendered unless this is exactly `true`. The Google client id/secret are NOT environment
# variables here — they live in the Supabase project (Authentication > Providers > Google), so a
# deployment needs no new secret. Leave unset until the provider is enabled AND verified in staging.
# NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN=false

# Admin-only /api/reports/* endpoints (screenshot/PDF storage). The Playwright
# report helpers and `npm run save:report` send this as a Bearer token when they
# run outside a signed-in browser session (CI / local tooling). It is the
# Supabase access token of an admin account; never expose it to the browser.
# REPORTS_API_TOKEN=

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# Supabase renamed the "anon" key to the "publishable" key (sb_publishable_...).
# Set either one; the app accepts both and prefers the legacy name when both exist.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: address diagnosed by `npm run diagnose:raya-admin-login` (read-only).
RAYA_ADMIN_EMAIL=
# Raya AI password recovery also needs the reset address on the project's
# redirect allow-list: Authentication > URL Configuration > Redirect URLs.
# See docs/RAYA_AI_PASSWORD_RECOVERY.md. This is a dashboard setting, not a
# variable here.

# Prisma migrations only. Use a DIRECT (non-pooled) PostgreSQL connection here:
# `prisma migrate` needs a session that can hold DDL locks, which a
# transaction-pooled URL cannot provide. Leave unset unless you are running
# migrations. The application runtime does not read this variable.
# PRISMA_DATABASE_URL=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres
