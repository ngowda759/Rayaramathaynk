rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for testimonials folder
    match /testimonials/{allPaths} {
      allow read: if true;
      allow write: if true;
    }
    
    // Other folders require authentication
    match /{allPaths} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
