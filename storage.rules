rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'temple_admin', 'Billing'];
    }
    
    // Allow admins to upload images to aaradhane folder
    match /aaradhane/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Allow authenticated users to upload general images
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Default deny
    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
